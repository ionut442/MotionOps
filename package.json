{
  "name": "motionops",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:lab": "vite --host 127.0.0.1 --mode lab",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.plugin.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lab:collector": "node scripts/motion-evidence-collector.mjs",
    "lab:collector:test": "node --test tests/motion-evidence-collector.test.mjs",
    "test:build-artifacts": "node --test tests/buildArtifacts.test.mjs",
    "test:release-package": "npm run package:release && node --test tests/releasePackage.node-test.mjs",
    "test:ui": "playwright test",
    "build": "npm run build:plugin && vite build && node scripts/inline-figma-ui.mjs",
    "build:plugin": "vite build --config vite.plugin.config.ts",
    "build:lab": "npm run build:plugin:lab && vite build --mode lab && node scripts/inline-figma-ui.mjs",
    "build:plugin:lab": "vite build --config vite.plugin.config.ts --mode lab",
    "package:release": "node scripts/build-release-package.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@figma/plugin-typings": "^1.130.0",
    "@playwright/test": "^1.54.1",
    "@types/node": "^24.0.13",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.31.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "fast-check": "^4.9.0",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.36.0",
    "vite": "^7.0.4",
    "vitest": "^3.2.4"
  }
}
